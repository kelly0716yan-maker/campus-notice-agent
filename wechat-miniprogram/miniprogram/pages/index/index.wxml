<view class="page">
  <view class="privacy-hint">请先去掉通知里的姓名、学号、电话等个人信息。</view>

  <view class="card">
    <textarea
      class="notice-input"
      value="{{text}}"
      maxlength="{{maxLength}}"
      placeholder="在这里粘贴通知原文"
      placeholder-class="input-placeholder"
      bindinput="onInput"
    />
    <view class="char-count {{text.length >= maxLength ? 'full' : ''}}">{{text.length}}/{{maxLength}}</view>
    <button
      class="primary-btn"
      bindtap="onExtract"
      loading="{{loading}}"
      disabled="{{loading}}"
    >{{loading ? '提取中…' : '提取'}}</button>

    <view class="error-box" wx:if="{{error}}">
      <text class="error-text">{{error}}</text>
      <button class="retry-btn" bindtap="onExtract">重试</button>
    </view>
  </view>

  <view class="card" wx:if="{{result}}">
    <view class="result-title">{{result.title}}</view>

    <view class="result-row">
      <view class="row-label">活动时间</view>
      <view class="row-value {{result.event_time === '未提及' ? 'unmentioned' : ''}}">{{result.event_time}}</view>
    </view>
    <view class="result-row">
      <view class="row-label">截止时间</view>
      <view class="row-value {{result.deadline === '未提及' ? 'unmentioned' : ''}}">{{result.deadline}}</view>
    </view>
    <view class="result-row">
      <view class="row-label">地点</view>
      <view class="row-value {{result.location === '未提及' ? 'unmentioned' : ''}}">{{result.location}}</view>
    </view>
    <view class="result-row">
      <view class="row-label">对象</view>
      <view class="row-value {{result.audience === '未提及' ? 'unmentioned' : ''}}">{{result.audience}}</view>
    </view>
    <view class="result-row">
      <view class="row-label">要做什么</view>
      <view class="row-value {{result.action === '未提及' ? 'unmentioned' : ''}}">{{result.action}}</view>
    </view>

    <view class="ai-note">结果由 AI 生成，请核对关键信息。</view>

    <view class="evidence-toggle" bindtap="toggleEvidence">
      <text>原文依据</text>
      <text class="arrow">{{showEvidence ? '▾' : '▸'}}</text>
    </view>
    <view class="evidence" wx:if="{{showEvidence}}">{{result.evidence}}</view>

    <button class="copy-btn" bindtap="onCopy">复制成文字</button>
  </view>

  <view class="card" wx:if="{{result}}">
    <view class="feedback-title">这次提取准吗？</view>
    <view class="feedback-btns">
      <button class="fb-btn" bindtap="onUp" disabled="{{feedbackSent}}">👍 准确</button>
      <button class="fb-btn" bindtap="onDown" disabled="{{feedbackSent}}">👎 有误</button>
    </view>
    <label class="consent-row">
      <checkbox checked="{{consent}}" bindchange="onConsent" />
      <text class="consent-text">允许把这条通知（已去掉个人信息）用于改进产品</text>
    </label>
    <view class="thanks" wx:if="{{feedbackSent}}">已收到反馈，谢谢！</view>
  </view>
</view>
